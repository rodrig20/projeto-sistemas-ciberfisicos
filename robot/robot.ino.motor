//#include "BluetoothController.h"
#include "RobotController.h"

RobotController rc(D6, D9, D3);

//BluetoothController ble("180C", "2A56");

int state = 0;

void setup() {
    Serial.begin(115200);

    // Inicializa o Robot
    rc.begin(START);

    //ble.begin();
    delay(1000);
}

void loop() {
    if (!rc.update()) {
        delay(1000);
        if (state == 0) rc.moveToPose(TC);
        if (state == 1) rc.moveToPose(DEFAULT);
        if (state == 2) rc.moveToPose(CC);
        if (state == 3) rc.moveToPose(DEFAULT);
        state++;
        state %= 4;
    }
}
